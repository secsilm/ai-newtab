# Only needed for the Node/Bun harness in harness/. The extension asks for the key in its UI.
ANTHROPIC_API_KEY=
# API_PROVIDER: anthropic (default) or openai-compatible
API_PROVIDER=anthropic
# For OpenAI-compatible harness runs. Include your provider's version path in the URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Exact model ID with Chat Completions function calling support.
OPENAI_MODEL=
# Optional: standing instructions for harness runs (same as the extension's Settings box)
HOMEPAGE_PROMPT=
